---
import Image from "astro/components/Image.astro";
import Button from "../components/button.astro";
import logo from "../../public/logo.webp";
import Footer from "../components/footer.astro";
const { titlePage } = Astro.props;
import {site} from '../const.ts'
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{titlePage}</title>

    <!-- Meta Descripción -->
    <meta
      name="description"
      content="¿Sospechas de fraude dentro de tu empresa? Protege tu negocio. Actúa legalmente contra empleados, socios o directivos desleales."
    />
    <meta name="keywords" content="fraude empresarial, abogados, defensa legal, recuperación de activos, derecho penal, derecho corporativo" />
    <meta name="author" content="LexAegis" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="LexAegis - Defensa en casos de fraude" />
    <meta
      property="og:description"
      content="¿Sospechas de fraude dentro de tu empresa? Protege tu negocio. Actúa legalmente contra empleados, socios o directivos desleales."
    />
    <meta property="og:image" content="/logo.jpg" />
    <meta property="og:url" content={site} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="LexAegis - Defensa en casos de fraude" />
    <meta
      name="twitter:description"
      content="¿Sospechas de fraude dentro de tu empresa? Protege tu negocio. Actúa legalmente contra empleados, socios o directivos desleales."
    />
    <meta name="twitter:image" content="/logo.jpg" />
    <meta name="twitter:site" content="@LexAegis" />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "LegalService",
      "name": "LexAegis",
      "description": "Especialistas en fraudes empresariales y defensa legal.",
      "url": site,
      "logo": "/logo.jpg",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Ciudad de México",
        "addressCountry": "MX"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "Servicios legales",
        "areaServed": "MX",
        "availableLanguage": "es"
      }
    }
    </script>

    <!-- Mejoras en el contraste -->
    <style is:global>
      :root {
        --color-primary: #b28e4a; /* Verifica contraste */
        --color-seccondary: #1c2639; /* Verifica contraste */
        --color-foreground: #817f7c; /* Verifica contraste */
        --color-marfil: #f7f6f4; /* Verifica contraste */
      }
    </style>

    <!-- Fuentes -->
    <!-- Optimización de carga de fuentes -->
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Playfair:ital,opsz,wght@0,5..1200,300..900;1,5..1200,300..900&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,100..900;1,100..900&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Playfair:ital,opsz,wght@0,5..1200,300..900;1,5..1200,300..900&display=swap" rel="stylesheet">
      <link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    </noscript>
  </head>
  <body>
    <div class="z-10 relative">
      <div class="absolute w-full">
        <div
          class="relative flex justify-between items-center gap-2 md:grid md:grid-cols-3 mx-auto h-42 text-white container"
        >
          <div class="logo">
            <Image
              src={logo}
              alt="Logotipo de LexAegis, especialistas en defensa legal"
              loading="eager"
              class="top-2 absolute w-auto h-32 md:h-45"
            />
          </div>
          <div class="hidden md:block w-full text-center text-nowrap">
            <nav class="flex justify-center nav-bar" aria-label="Menú principal">
              <ul class="flex justify-center gap-2 space-x-4">
                <li><a href="#" aria-label="Ir a la página de inicio">Inicio</a></li>
                <li><a href="#nosotros" aria-label="Leer sobre nosotros">Sobre nosotros</a></li>
                <li><a href="#servicios" aria-label="Explorar nuestros servicios">Nuestros servicios</a></li>
                <li><a href="#contacto" aria-label="Ir a la sección de contacto">Contáctenos</a></li>
              </ul>
            </nav>
          </div>
          <div class="md:hidden block">
            <ul class="flex justify-center gap-2 space-x-4">
              <li><a href="#servicios" class="underline" aria-label="Explorar nuestros servicios">SERVICIOS</a></li>
              <li><a href="#contacto" class="underline" aria-label="Ir a la sección de contacto">CONTACTO</a></li>
            </ul>
          </div>
          <div class="hidden md:block text-end">
            <a href="#contacto" aria-label="Solicitar una consulta gratuita">
              <Button>Consulta grátis</Button>
            </a>
          </div>
        </div>
      </div>
    </div>
    <div class="">
      <!-- Meta etiquetas adicionales -->
      <meta name="theme-color" content="#b28e4a" />
      <meta name="application-name" content="LexAegis" />
      <meta name="apple-mobile-web-app-title" content="LexAegis" />
      <meta name="apple-mobile-web-app-capable" content="yes" />
      <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
      <meta name="format-detection" content="telephone=no" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
      
      <!-- Meta etiquetas de seguridad -->
      <meta http-equiv="Content-Security-Policy" content="default-src 'self'; img-src 'self' data:; script-src 'self'; style-src 'self' 'unsafe-inline';" />
      <meta http-equiv="X-UA-Compatible" content="IE=edge" />
      
      <!-- Meta etiquetas de rendimiento -->
      <link rel="manifest" href="/manifest.json" />
      <link rel="dns-prefetch" href="//fonts.googleapis.com" />
      <link rel="dns-prefetch" href="//fonts.gstatic.com" />
      <link rel="preload" href="/path/to/critical.css" as="style" />
      <link rel="preload" href="/path/to/critical.js" as="script" />
      <slot />
    </div>
    <Footer /> 
  </body>
</html>
<style is:global>
  @import "tailwindcss";

  :root {
    --color-primary: #b28e4a;
    --color-seccondary: #1c2639;
    --color-foreground: #817f7c;
    --color-marfil: #f7f6f4;
  }

  * {
    font-family: "Jost", serif;
    font-optical-sizing: auto;
    font-style: normal;
  }
  body {
    font-size: 18px;
    overflow-x: hidden;
  }
  p {
    color: var(--color-foreground);
  }
  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-weight: 400;
    font-family: "Playfair", serif;
    font-optical-sizing: auto;
    font-style: normal;
  }

  h1 {
    font-size: 5rem;
    line-height: 5.5rem;
  }
  @media screen and (max-width: 550px) {
    h1 {
      font-size: 2.5rem;
      line-height: 3rem;
    }
    h2 {
      font-size: 2.5rem;
      line-height: 3rem;
    }

    h3 {
      font-size: 2rem;
      line-height: 2.5rem;
    }
    h4 {
      font-size: 1.5rem;
      line-height: 2rem;
    }
    h5 {
      font-size: 1.25rem;
      line-height: 1.75rem;
    }
    .container {
      padding: 0px 1rem;
    }
  }
  h1 > span {
    font-style: italic;
    font-weight: bold;
    color: var(--color-primary);
    font-family: "Playfair", serif;
  }

  h2 {
    font-size: 3rem;
    line-height: 3.5rem;
  }

  h2 > span {
    font-style: italic;
    font-weight: bold;
    color: var(--color-primary);
    font-family: "Playfair", serif;
  }

  h3 {
    font-size: 1.8rem;
    line-height: 3.5rem;
  }

  h3 > span {
    font-style: italic;
    font-weight: bold;
    color: var(--color-primary);
    font-family: "Playfair", serif;
  }

  h4 {
    font-size: 1.4rem;
    line-height: 2rem;
  }

  h4 > span {
    font-style: italic;
    font-weight: bold;
    color: var(--color-primary);
    font-family: "Playfair", serif;
  }

  @layer utilities {
    .bg-primary {
      background: var(--color-primary);
    }
    .border-primary {
      border-color: var(--color-primary);
    }
    .border-secondary {
      border-color: var(--color-seccondary);
    }
    .bg-secondary {
      background: var(--color-seccondary);
    }
    .text-primary {
      color: var(--color-primary) !important;
    }
    .text-secondary {
      color: var(--color-seccondary);
    }
    .text-foreground {
      color: var(--color-foreground);
    }
    .text-marfil {
      color: var(--color-marfil);
    }
  }

  .btn-outline {
    padding: 17px 34px;
    border-radius: 100px;
    border: 1px solid var(--color-primary);
    transition: all 0.3s ease-in-out;
  }

  .btn {
    padding: 8px 30px;
    border-radius: 100px;
    border: 1px solid var(--color-slate-800);
    transition: all 0.3s ease-in-out;
  }

  .btn:hover {
    transform: translate3d(0px, -3px, 0.01px);
    background: var(--color-primary);
    color: white;
  }
  .italic {
    font-style: italic;
  }
  .logo > img {
    transition: all 0.3s ease-in-out;
  }
  .logo:hover > img {
    transform: translate3d(0px, -3px, 0.01px);
  }
  .btn-outline:hover {
    transform: translate3d(0px, -3px, 0.01px);
    background: var(--color-primary);
    color: white;
  }

  .nav-bar li a {
    transition: all 0.3s ease-in-out;
    font-size: 18px;
  }

  .nav-bar li:hover a {
    color: var(--color-primary);
  }

  ul li {
    line-height: 2.5rem;
  }

  .card {
    background: var(--color-marfil);
    padding: 20px;
    border-radius: 20px;
  }
  .card .icon {
    margin: auto;
    /* width: 50px;
  height: 50px; */
    size: 40px;
    color: var(--color-primary);
    display: inline-block;
  }

  .card-practices {
    transition: all 0.3s ease-in-out;
  }
  .card-practices:hover {
    transform: translate3d(0px, -3px, 0.01px);
    color: white;
  }

  input,
  textarea {
    max-width: 100%;
    margin-bottom: 20px;
    padding: 15px;
    height: auto;
    background-color: transparent;
    -webkit-box-shadow: none;
    box-shadow: none;
    display: block;
    width: 100%;
    line-height: 1.5em;
    font-family: "Jost", sans-serif;
    font-size: 18px;
    font-weight: 400;
    color: #817f7c;
    background-image: none;
    border-color:
      ease-in-out 0.15s,
      box-shadow ease-in-out 0.15s;
    border: 1px solid #91765a33;
    border-radius: 6px;
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 0.2rem rgba(178, 142, 74, 0.25);
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--color-foreground);
    opacity: 1; /* Firefox */
  }
  input:-ms-input-placeholder,
  textarea:-ms-input-placeholder {
    color: var(--color-foreground);
  } /* Internet Explorer 10-11 */

  textarea::-ms-input-placeholder {
    color: var(--color-foreground);
  } /* Microsoft Edge */

  textarea {
    width: 100% !important;
  }
</style>
