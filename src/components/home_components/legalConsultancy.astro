---
import Image from "astro/components/Image.astro";
import Foldersearch from "../svg/foldersearch.astro";
import lega from "@public/about2.jpeg";
import Container from "../container.astro";
---

<div class="bg-secondary mt-12 md:mt-0 py-12">
  <Container class="text-white">
    <div class="gap-4 grid grid-cols-1 md:grid-cols-2">
      <div class="flex justify-center items-center">
        <Image
          src={lega}
          alt="legal"
          class="shadow-2xl rounded-md w-auto h-[70%]"
        />
      </div>
      <div class="flex flex-col justify-center items-center">
        <div class="md:w-[80%]">
          <span
            class="md:inline-flex items-center gap-2 text-xl text-center italic"
          >
            <span
              class="hidden md:flex justify-center items-center bg-primary p-2 rounded-full"
            >
              <Foldersearch color="#ffff" size={25} />
            </span>
            Evaluamos tu caso y
            <span class="text-primary italic">reunimos pruebas.</span>
          </span>
          <h2 class="text-pretty">
            Caso real de una <span>empresa protegida</span>
          </h2>
          <p class="text-slate-300!">
            Una empresa en <b>Monterrey</b> detectó desvíos de recursos por parte
            de un gerente. Tras presentar pruebas, se procedió legalmente y el juez
            ordenó el embargo de una propiedad. Recuperaron más de <b
              >$800,000</b
            >
            pesos en menos de 6 meses.
          </p>
          <div class="mt-4">
            <span class="font-bold text-primary!"
              >Tú también puedes hacerlo.</span
            >
          </div>
        </div>
      </div>
    </div>
  </Container>
</div>
