---
import Container from "../container.astro";
import Foldersearch from "../svg/foldersearch.astro";
import Slidercases from "./slidercases.astro";
---

<Container class="py-12">
  <div class="relative grid grid-cols-1 md:grid-cols-2" id="study-case">
    <div class="flex items-center min-h-[600px]">
      <div class="w-[58%]">
        <span
          class="md:inline-flex items-center gap-2 text-xl text-center italic"
        >
          <span
            class="flex justify-center items-center bg-primary rounded-full w-12 h-12"
          >
            <Foldersearch color="#ffff" size={25} />
          </span>
          Evaluamos tu caso y reunios pruebas
        </span>
        <h2>Casos de <span>estudios</span></h2>
        <p>
          Lawyer sit amet risus ac duin auctor posuere fanish amet the acinia
          lecra fermen.
        </p>
      </div>
    </div>
    <div>
      <!-- <Slidercases /> -->
    </div>
  </div>
</Container>
