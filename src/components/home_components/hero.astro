---
import Button from "../button.astro";
import Container from "../container.astro";
---

<div
  class="relative flex flex-col justify-center items-center bg-cover bg-center w-[100vw] h-screen"
  style="background-image: url('/hero1.webp'); background-attachment: fixed;"
  role="banner"
  aria-label="Sección principal con imagen de fondo"
>
  <div class="z-0 absolute bg-black/50 w-full h-screen" aria-hidden="true">
  </div>
  <Container class="z-10">
    <div class="flex flex-col justify-center items-center">
      <div class="mx-auto text-white text-center">
        <span class="z-10 text-slate-300 text-2xl italic"
          >Solución legal confiable</span
        >
        <h1 class="z-10 mt-4">
          Defensa en casos de <br />
          <span>fraude interno o externo</span>
        </h1>
      </div>
      <div class="mt-6 text-white">
        <a href="#nosotros" aria-label="Ir a la sección sobre nosotros">
          <Button>información sobre nosotros</Button>
        </a>
      </div>
    </div>
  </Container>
</div>
