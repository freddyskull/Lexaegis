---
import Container from "../container.astro";
import Briefcase from "../svg/briefcase.astro";
import Message from "../svg/message.astro";
import Mace from "../svg/mace.astro";
import List from "../svg/list.astro";
import Usercheck from "../svg/usercheck.astro";
import House from "../svg/house.astro";
import Scroll from "../svg/scroll.astro";
import Scale from "../svg/scale.astro";
import HandsShake from "../svg/handsShake.astro";
import ShieldQuestion from "../svg/shielQuestion.astro";

const items = [
  {
    icon: Briefcase,
    title: "Fraudes Empresariales",
    description:
      "Investigación y defensa en casos de fraude interno o externo, Asesoría legal y acompañamiento Recuperación de activos",
  },
  {
    icon: House,
    title: "Fideicomisos",
    description:
      "Asesoría integral en fideicomisos para protección de activos, seguridad jurídica y cumplimiento de objetivos específicos con un enfoque estratégico.",
  },
  {
    icon: Message,
    title: "Consultoría Preventiva",
    description:
      "Revisión de contratos y estructura legal, diagnóstico de riesgos legales y fiscales, planeación jurídica para evitar fraudes o problemas con el SAT",
  },
  {
    icon: Mace,
    title: "Conflictos Legales Empresariales",
    description:
      "Demandas entre socios, contratos incumplidos, defensa ante juicios mercantiles",
  },
  {
    icon: Usercheck,
    title: "Créditos Fiscales y Defensa ante el SAT",
    description:
      "Soluciones legales ante adeudos fiscales, defensa ante actos de autoridad (auditorías, multas, embargos), Regularización fiscal y negociaciones con el SAT",
  },
  {
    icon: Scroll,
    title: "Herencias Accionarias y Sucesión Empresarial",
    description:
      "Asesoramos en la sucesión de empresas familiares, garantizando una transición ordenada y protegiendo el legado empresarial.",
  },
];

const itemsSection2 = [
  {
    icon: Briefcase,
    title: "asesoría legal. en compra, venta y renta de inmuebles.",
    hidden: false,
    link: "asesoria-inmobiliaria",
  },

  {
    icon: Scroll,
    title:
      "Revisión y elaboración de contratos de compraventa, arrendamiento o cesión",
    hidden: false,
    link: "/contratos-compra-venta",
  },
  {
    icon: House,
    title: "Regularización de propiedades",
    hidden: false,
    link: "/regularizacion-propiedades",
  },
  {
    icon: Mace,
    title: "Defensa en conflictos por posesión, uso o propiedad",
    hidden: false,
    link: "posesion-uso-propiedad",
  },
  {
    icon: ShieldQuestion,
    title: "porque contratar LexAegis y no un abogado particular",
    hidden: false,
    link: "/porque-lexaegis",
  },
  {
    icon: HandsShake,
    title: "Asesoría en compra, renta o venta de inmuebles",
    hidden: false,
    link: "/asesoria-compra-venta",
  },
];
---

<div class="bg-[#FEF3E8] py-12">
  <Container
    class="mt-24 md:mt-0 py-12"
    role="region"
    aria-labelledby="practice-areas-heading"
  >
    <div class="flex flex-col-reverse md:gap-12 md:grid md:grid-cols-3">
      <div
        class="items-center gap-6 grid grid-cols-1 md:grid-cols-3 col-span-2 mt-24 md:mt-0 text-center"
        role="list"
      >
        {
          items.map((item) => {
            const Icon = item.icon;
            return (
              <div
                class="relative shadow-md py-16! overflow-hidden card"
                role="listitem"
              >
                <div class="icon" aria-hidden="true">
                  <Icon size={70} />
                </div>
                <h4 class="text-2xl text-pretty leading-8">{item.title}</h4>
                <p>{item.description}</p>
                <div
                  class="-right-10 -bottom-10 absolute opacity-3"
                  aria-hidden="true"
                >
                  <Icon size={180} color="#000" />
                </div>
              </div>
            );
          })
        }
      </div>
      <div class="flex justify-end items-center">
        <div class="bg-white shadow-md p-6 rounded-md">
          <div class="flex flex-col justify-center text-center">
            <span
              class="flex justify-center items-center gap-2 text-xl italic"
              aria-hidden="true"
            >
              <span
                class="flex justify-center items-center bg-primary p-2 rounded-full"
              >
                <List color="#ffff" size={25} />
              </span>
              Algunos de <span class="text-primary italic"
                >nuestro servicios</span
              >
            </span>
            <h2 id="practice-areas-heading">
              Nos especializamos en <span>brindar</span> apoyo
            </h2>
            <p class="mt-2 text-pretty">
              Nos enfocamos en ofrecer soluciones legales personalizadas y
              efectivas para satisfacer las necesidades específicas de nuestros
              clientes.
            </p>
          </div>
        </div>
      </div>
    </div>
  </Container>
</div>

<Container>
  <div class="md:gap-12 grid grid-cols-1 md:grid-cols-3 mt-24">
    <div class="flex flex-col justify-center text-center">
      <span
        class="flex justify-center items-center gap-2 text-xl italic"
        aria-hidden="true"
      >
        <span
          class="flex justify-center items-center bg-primary p-2 rounded-full"
        >
          <Scale color="#ffff" size={25} />
        </span>
        respaldo <span class="text-primary italic">jurídico sólido</span>
      </span>
      <h2 id="practice-areas-heading">
        Protección <span>estratégica</span> para tus intereses.
      </h2>
      <p class="mt-2 text-pretty">
        Ya sea que tu empresa esté expandiendo operaciones, consolidando
        patrimonio o iniciando un proyecto inmobiliario, en LexAegis protegemos
        tus intereses con la misma precisión y enfoque estratégico que nos
        caracteriza en el ámbito corporativo.
      </p>
    </div>
    <div
      class="items-center gap-6 grid grid-cols-1 md:grid-cols-3 col-span-2 mt-24 md:mt-0 text-center"
      role="list"
    >
      {
        itemsSection2.map((item) => {
          const Icon = item.icon;
          return (
            <a href={item.link}>
              <div
                class={`relative hover:bg-slate-900! py-16! overflow-hidden hover:text-white transition card card-practices ${item.hidden && "hidden"} shadow-md`}
                role="listitem"
              >
                <div class="icon" aria-hidden="true">
                  <Icon size={70} />
                </div>
                <h4 class="text-2xl text-pretty leading-8">{item.title}</h4>
                <div
                  class="-right-10 -bottom-10 absolute opacity-3"
                  aria-hidden="true"
                >
                  <Icon size={180} color="#000" />
                </div>
              </div>
              <div class={`${!item.hidden && "hidden"}`} />
            </a>
          );
        })
      }
    </div>
  </div>
</Container>
