---
import Check from "@svg/check.astro";
import Scale from "@svg/scale.astro";
import Graduate from "@svg/graduate.astro";
import Usercheck from "@svg/usercheck.astro";
import Cloack from "@svg/cloack.astro";
import { Image } from "astro:assets";
import about from "@public/about4.webp";
import Openbook from "@svg/openbook.astro";
import Container from "../container.astro";
---

<Container>
  <div
    class="items-center grid grid-cols-1 md:grid-cols-3 md:grid-flow-row-dense mt-26"
    role="region"
    aria-labelledby="about-us-heading"
  >
    <div class="order-2 md:order-1 mt-22">
      <span class="flex items-center gap-2 text-xl italic">
        <span
          class="flex justify-center items-center bg-primary p-2 rounded-full"
          aria-hidden="true"
        >
          <Openbook color="#ffff" size={25} />
        </span>
        <span id="about-us-heading"
          >un poco sobre <span class="text-primary italic">nosotros</span></span
        >
      </span>
      <h2 class="mt-2 font-bold!">
        Protege tu negocio. Actúa ahora <span>dentro de la ley</span>
      </h2>
      <p class="my-4">
        En Lexaegis, entendemos que el mundo empresarial va más allá de las
        operaciones comerciales. Por eso, ofrecemos asesoría legal especializada
        en propiedad inmobiliaria, dirigida a empresarios, inversionistas y
        entidades corporativas que buscan proteger, adquirir o gestionar activos
        inmobiliarios con respaldo jurídico sólido.
      </p>
      <ul class="pl-5 list-disc">
        <li class="flex items-center gap-2">
          <Check aria-hidden="true" />
          <span>Te ayudamos a recuperar lo que te pertenece.</span>
        </li>
        <li class="flex items-center gap-2">
          <Check aria-hidden="true" />
          <span>No es solo dinero. Es tu empresa en riesgo.</span>
        </li>
      </ul>

      <!-- <button class="bg-slate-800 mt-6 text-white btn">Saber más</button> -->
    </div>
    <div class="flex justify-center order-1 md:order-2 col-span-2">
      <Image
        src={about}
        class="shadow-2xl rounded-md w-[100%] md:w-[60%]"
        alt="Imagen representativa sobre nosotros"
      />
    </div>
  </div>

  <div
    class="gap-6 grid grid-cols-1 md:grid-cols-4 mt-22 pb-12"
    role="region"
    aria-labelledby="features-heading"
  >
    <h3 id="features-heading" class="sr-only">Características principales</h3>
    <div class="flex gap-6">
      <div class="" aria-hidden="true">
        <Scale size={75} />
      </div>
      <div>
        <h4>Resultados comprobados</h4>
        <p>Hemos resuelto numerosos casos, con resultados contundentes.</p>
      </div>
    </div>
    <div class="flex gap-6">
      <div aria-hidden="true">
        <Graduate size={75} />
      </div>
      <div>
        <h4>Experiencia especializada</h4>
        <p>
          Años de experiencia protegiendo tus intereses y los de tu empresa.
        </p>
      </div>
    </div>
    <div class="flex gap-6">
      <div aria-hidden="true">
        <Cloack size={70} />
      </div>
      <div>
        <h4>Atención personalizada</h4>
        <p>Recibe asesoría y soluciones adaptadas a tus necesidades.</p>
      </div>
    </div>
    <div class="flex gap-6">
      <div aria-hidden="true">
        <Usercheck size={75} />
      </div>
      <div>
        <h4>Confianza reconocida</h4>
        <p>Premios y reconocimientos avalan nuestro compromiso y excelencia.</p>
      </div>
    </div>
  </div>
</Container>
