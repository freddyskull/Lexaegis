---
import { contact } from "../../const";
import Container from "../container.astro";
import Email from "../svg/email.astro";
---

<div class="bg-gradient-to-b from-white to-[#fff3e8] py-24">
  <Container>
    <div class="items-center grid grid-cols-1 md:grid-cols-2">
      <div
        class="bg-[#14100C] shadow-2xl mt-12 md:mt-0 p-10 rounded-md md:w-[70%] text-white text-center"
      >
        <form
          name="contacto"
          method="POST"
          netlify
          aria-labelledby="form-title"
        >
          <h2 id="form-title">Escríbenos <span>ahora</span></h2>
          <input
            id="name"
            name="name"
            type="text"
            placeholder="Nombre completo"
            aria-required="true"
            required
          />
          <div class="md:gap-6 grid grid-cols-1 md:grid-cols-2">
            <input
              id="email"
              name="email"
              type="email"
              placeholder="Dirección de correo electrónico"
              aria-required="true"
            />
            <input
              id="phone"
              name="phone"
              type="tel"
              placeholder="Número de teléfono"
              aria-required="false"
              required
            />
          </div>
          <div class="w-full">
            <textarea
              id="message"
              name="message"
              placeholder="Dejanos tu mensaje"
              rows="6"
              class="w-full"
              required
              aria-required="true"></textarea>
          </div>
          <div data-netlify-recaptcha="true"></div>

          <div class="w-full">
            <button
              type="submit"
              class="py-3! border-[#91765a]! w-full btn"
              aria-label="Enviar mensaje"
            >
              Enviar mensaje
            </button>
          </div>
        </form>
      </div>
      <div>
        <div class="mt-24 md:mt-0 text-center">
          <span class="flex justify-center items-center gap-2 text-xl italic">
            <span
              class="flex justify-center items-end bg-primary p-2 rounded-full"
            >
              <Email color="#ffff" size={25} aria-hidden="true" />
            </span>
            Le responderemos <span class="text-primary italic">muy pronto</span>
          </span>
          <h2 class="mt-2">
            ¿Necesitas ayuda?<br />
            <span>Contacta</span> con nosotros
          </h2>
        </div>
        <div class="flex flex-col justify-center items-center">
          {
            contact.map((item) => {
              return (
                <div class="flex flex-col justify-center items-center gap-6 mt-6">
                  <div class="flex flex-col text-center">
                    <h4>{item.title}</h4>
                    <p id={`contact-${item.title}`}>{item.label}</p>
                  </div>
                </div>
              );
            })
          }
        </div>
      </div>
    </div>
  </Container>
</div>
