---
import { contact } from "../../const";
import Container from "../container.astro";
import Email from "../svg/email.astro";
---

<div class="bg-gradient-to-b from-white to-[#fff3e8] py-24">
  <Container>
    <div class="items-center grid grid-cols-1 md:grid-cols-2">
      <div
        class="bg-[#14100C] shadow-2xl mt-12 md:mt-0 p-10 rounded-md md:w-[70%] text-white text-center"
      >
        <h2>Escríbenos <span>ahora</span></h2>
        <!-- <form action="contact" method="POST" data-netlify="true" class="mt-4">
          <input name="nombre" type="text" placeholder="Nombre completo" />
          <div class="md:gap-6 grid grid-cols-1 md:grid-cols-2">
            <input
              name="direccion"
              type="text"
              placeholder="Dirección de correo electrónico"
            />
            <input
              name="telefono"
              type="text"
              placeholder="Número de teléfono"
            />
          </div>
          <div class="w-full">
            <textarea
              name="mensaje"
              placeholder="Dejanos tu mensaje"
              rows="6"
              class="w-full"></textarea>
          </div>
          <div class="w-full">
            <button type="submit" class="py-3! border-[#91765a]! w-full btn"
              >Enviar mensaje</button
            >
          </div>
        </form> -->
        <form name="contact" method="POST" netlify>
          <p>
            <label>Your Name: <input type="text" name="name" /></label>
          </p>
          <p>
            <label>Your Email: <input type="email" name="email" /></label>
          </p>
          <p>
            <label
              >Your Role: <select name="role[]" multiple>
                <option value="leader">Leader</option>
                <option value="follower">Follower</option>
              </select></label
            >
          </p>
          <p>
            <label>Message: <textarea name="message"></textarea></label>
          </p>
          <p>
            <button type="submit">Send</button>
          </p>
        </form>
      </div>
      <div>
        <div class="text-center">
          <span class="flex justify-center items-center gap-2 text-xl italic">
            <span
              class="flex justify-center items-end bg-primary p-2 rounded-full"
            >
              <Email color="#ffff" size={25} />
            </span>
            Le responderemos <span class="text-primary italic">muy pronto</span>
          </span>
          <h2 class="mt-2">
            ¿Necesitas ayuda?<br />
            <span>Contacta</span> con nosotros
          </h2>
        </div>
        <div class="flex flex-col justify-center items-center">
          {
            contact.map((item) => {
              const Icon = item.icon;
              return (
                <div class="flex flex-col justify-center items-center gap-6 mt-6">
                  {/* <div class="bg-white p-4 rounded-full">
                    <Icon color="#B28E4A" />
                  </div> */}
                  <div class="flex flex-col text-center">
                    <h4>{item.title}</h4>
                    <p>{item.label}</p>
                  </div>
                </div>
              );
            })
          }
        </div>
      </div>
    </div>
  </Container>
</div>
