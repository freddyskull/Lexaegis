---
import Container from "./container.astro";
import { contact, social_networks as social } from "../const";
import AngleRigth from "./svg/angleRigth.astro";
import Phone from "./svg/phone.astro";
import Image from "astro/components/Image.astro";
import logo from "../../public/logo.webp";
import Check from "./svg/check.astro";
---

<div
  class="bg-slate-600 bg-cover bg-center py-24 md:py-0"
  style="background-image: url('/bannerFooter.webp'); background-attachment: fixed;"
>
  <Container class="gap-12 grid grid-cols-1 md:grid-cols-3 py-24 text-white">
    <div class="col-span-2 md:text-left">
      <h2 class="text-4xl!">
        Contáctanos hoy mismo<br />
        <span>Primera evaluación</span> gratuita.
      </h2>
    </div>
    <div class="flex items-center gap-4">
      <!-- <div
        class="flex justify-center items-center bg-primary rounded-full w-12 h-12 text-white"
      >
        <span class="text-2xl">
          <Phone color="#fff" size={30} />
        </span>
      </div> -->
      <div>
        <p class="text-primary text-xl">Escríbenos</p>
        <a href={contact[0].link}>
          <p class="font-[600] text-white! text-2xl md:text-3xl">
            {contact[0].label}
          </p>
        </a>
      </div>
    </div>
  </Container>
</div>

<div class="bg-[#14100C]">
  <Container>
    <div
      class="gap-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 py-18 text-foreground"
    >
      <div>
        <div
          class="flex md:flex-row flex-col items-center gap-6 md:text-left text-center"
        >
          <Image src={logo} alt="Logo lexaegis" class="w-auto h-42" />
          <div>
            <p class="mb-4">
              Especializado en fraudes empresariales, con abogados expertos en
              derecho penal y corporativo.
            </p>
            <!-- <ul
              class="flex justify-center md:justify-start gap-2 my-8 md:my-0 text-pretty"
            >
              {
                social.map((network) => {
                  const Icon = network.icon;
                  return (
                    <li class="social-icon">
                      <a
                        href={network.url}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <Icon color="#fff" />
                      </a>
                    </li>
                  );
                })
              }
            </ul> -->
          </div>
        </div>
      </div>
      <div
        class="col-span-1 md:col-span-2 xl:col-span-1 lg:mx-auto mt-12 md:mt-0"
      >
        <h3>¿Por qué elegirnos?</h3>
        <ul class="">
          <li class="flex items-center gap-2">
            <Check /> Experiencia legal especializada
          </li>
          <li class="flex items-center gap-2">
            <Check /> Resultados comprobados
          </li>
          <li class="flex items-center gap-2">
            <Check /> Atención personalizada
          </li>
        </ul>
        <!-- <form action="">
          <input type="text" />
          <div class="right-2 bottom-2 absolute">
            <button type="submit">
              <AngleRigth color="white" />
            </button>
          </div>
        </form> -->
      </div>
      <div class="lg:mx-auto">
        <h3>Contáctanos</h3>
        <ul class="text-pretty">
          {
            contact.map((value: any) => (
              <li class="contact-link">
                <a target="_blank" href={value.link}>
                  {value.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Container>
</div>

<style>
  h1,
  h2,
  h3,
  h4 {
    color: white;
  }
  form {
    position: relative;
  }
  form button {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 45px;
    width: 45px;
    background: #ac835d;
    color: #fff;
    outline: none;
    text-align: center;
    cursor: pointer;
    top: 25px;
    right: 10px;
    border-radius: 100%;
    outline: none;
  }
  input {
    margin-top: 20px;
    height: 60px;
    width: 100%;
    border: none;
    background: transparent;
    font-size: 18px;
    font-weight: 400;
    color: #aba59f;
    outline: none;
    padding: 0 90px 0 20px;
    border: 1px solid rgba(145, 118, 90, 0.2);
    border-radius: 30px;
  }
  .social-icon {
    background: #ac835d;
    padding: 10px;
    border-radius: 100px;
    color: white;
    transition: all 0.3s ease-in-out;
  }
  .social-icon:hover {
    transform: translate3d(0px, -3px, 0.01px);
  }
  .contact-link {
    transition: all 0.3s ease-in-out;
  }
  .contact-link:hover {
    color: #ac835d;
    text-decoration: underline;
  }
</style>
