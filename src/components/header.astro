---
import Image from "astro/components/Image.astro";
import logo from "@public/logo.webp";
import Button from "../components/button.astro";
---

<div class="z-10 relative" role="banner" aria-label="Encabezado principal">
  <div class="absolute w-full">
    <div
      class="relative flex justify-between items-center gap-2 md:grid md:grid-cols-3 mx-auto h-42 text-white container"
    >
      <div class="logo">
        <image
          src={logo}
          alt="Logotipo de LexAegis, especialistas en defensa legal"
          loading="eager"
          class="top-2 absolute w-auto h-32 md:h-45"
        />
      </div>
      <div class="hidden md:block w-full text-center text-nowrap">
        <nav class="flex justify-center nav-bar" aria-label="Menú principal">
          <ul class="flex justify-center gap-2 space-x-4">
            <li>
              <a href="#" aria-label="Ir a la página de inicio">Inicio</a>
            </li>
            <li>
              <a href="#nosotros" aria-label="Leer sobre nosotros"
                >Sobre nosotros</a>
            </li>
            <li>
              <a href="#servicios" aria-label="Explorar nuestros servicios"
                >Nuestros servicios</a>
            </li>
            <li>
              <a href="#contacto" aria-label="Ir a la sección de contacto"
                >Contáctenos</a>
            </li>
          </ul>
        </nav>
      </div>
      <div class="md:hidden block" aria-label="Menú móvil">menu-movil</div>
      <div class="hidden md:block text-end">
        <a href="#contacto" aria-label="Solicitar una consulta gratuita">
          <Button>Consulta grátis</Button>
        </a>
      </div>
    </div>
  </div>
</div>
